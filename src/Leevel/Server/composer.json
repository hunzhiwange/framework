{
  "name": "leevel/server",
  "description": "The Leevel Server Package.",
  "license": "MIT",
  "homepage": "http://queryphp.com",
  "support": {
    "issues": "https://github.com/hunzhiwange/framework/issues",
    "source": "https://github.com/hunzhiwange/framework"
  },
  "authors": [{
    "name": "Xiangmin Liu",
    "email": "635750556@qq.com"
  }],
  "require": {
    "php": ">=8.4.1",
    "leevel/http": "^2.0",
    "leevel/kernel": "^2.0",
    "leevel/di": "^2.0",
    "leevel/log": "^2.0",
    "leevel/router": "^2.0",
    "leevel/support": "^2.0",
    "leevel/filesystem": "^2.0",
    "symfony/process": "^7.2.0"
  },
  "require-dev": {
    "swoole/ide-helper": "^5.1.3"
  },
  "suggest": {
    "leevel/console": "Required to use the make commands (^2.0).",
    "ext-swoole": "Required to use swoole (^5.1.3)."
  },
  "autoload": {
    "psr-4": {
      "Leevel\\Level\\": ""
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "2.0-dev"
    },
    "leevel": {
      "providers": [
        "Leevel\\Server\\Provider\\Register"
      ],
      "commands": "Leevel\\Server\\Console"
    }
  },
  "minimum-stability": "dev"
}

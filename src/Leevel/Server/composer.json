{
  "name": "leevel/server",
  "description": "The Leevel Server Package.",
  "license": "MIT",
  "homepage": "http://queryphp.com",
  "support": {
    "issues": "https://github.com/hunzhiwange/framework/issues",
    "source": "https://github.com/hunzhiwange/framework"
  },
  "authors": [{
    "name": "Xiangmin Liu",
    "email": "635750556@qq.com"
  }],
  "require": {
    "php": ">=8.3",
    "leevel/http": "^1.1",
    "leevel/kernel": "^1.1",
    "leevel/di": "^1.1",
    "leevel/log": "^1.1",
    "leevel/router": "^1.1",
    "leevel/support": "^1.1",
    "leevel/filesystem": "^1.1"
  },
  "require-dev": {
    "swoole/ide-helper": "^5.1.3"
  },
  "suggest": {
    "leevel/console": "Required to use the make commands (^1.1).",
    "ext-swoole": "Required to use swoole (^5.1.3)."
  },
  "autoload": {
    "psr-4": {
      "Leevel\\Level\\": ""
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "1.1-dev"
    },
    "leevel": {
      "providers": [
        "Leevel\\Server\\Provider\\Register"
      ],
      "commands": "Leevel\\Server\\Console"
    }
  },
  "minimum-stability": "dev"
}

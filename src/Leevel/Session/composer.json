{
    "name": "leevel/session",
    "description": "The Leevel Session Package.",
    "license": "MIT",
    "homepage": "http://queryphp.com",
    "support": {
        "issues": "https://github.com/hunzhiwange/framework/issues",
        "source": "https://github.com/hunzhiwange/framework"
    },
    "authors": [{
        "name": "Xiangmin Liu",
        "email": "635750556@qq.com"
    }],
    "require": {
        "php": ">=8.3",
        "leevel/support": "^2.0",
        "leevel/cache": "^2.0"
    },
    "suggest": {
        "leevel/http": "Required to use session middleware (^2.0).",
        "leevel/filesystem": "Required to use the make commands (^2.0).",
        "leevel/kernel": "Required to use the make commands (^2.0).",
        "leevel/console": "Required to use the make commands (^2.0)."
    },
    "autoload": {
        "psr-4": {
            "Leevel\\Session\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.0-dev"
        },
        "leevel": {
            "providers": [
                "Leevel\\Session\\Provider\\Register"
            ],
            "commands": "Leevel\\Session\\Console"
        }
    },
    "minimum-stability": "dev"
}

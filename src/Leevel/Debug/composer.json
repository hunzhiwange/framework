{
    "name": "leevel/debug",
    "description": "The Leevel Debug Package.",
    "license": "MIT",
    "homepage": "http://queryphp.com",
    "support": {
        "issues": "https://github.com/hunzhiwange/framework/issues",
        "source": "https://github.com/hunzhiwange/framework"
    },
    "authors": [{
        "name": "Xiangmin Liu",
        "email": "635750556@qq.com"
    }],
    "require": {
        "php": ">=8.4.1",
        "leevel/di": "^2.0",
        "leevel/support": "^2.0",
        "leevel/kernel": "^2.0",
        "leevel/database": "^2.0",
        "leevel/event": "^2.0",
        "leevel/log": "^2.0",
        "leevel/http": "^2.0",
        "leevel/session": "^2.0",
        "maximebf/debugbar": "^1.23.3",
        "symfony/var-dumper": "^7.1.8",
        "symfony/http-foundation": "^7.1.8"
    },
    "suggest": {
        "leevel/console": "Required to use the make commands (^2.0).",
        "leevel/filesystem": "Required to use the make commands (^2.0).",
        "leevel/kernel": "Required to use the make commands (^2.0)."
    },
    "autoload": {
        "psr-4": {
            "Leevel\\Debug\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.0-dev"
        },
        "leevel": {
            "providers": [
                "Leevel\\Debug\\Provider\\Register"
            ]
        }
    },
    "minimum-stability": "dev"
}

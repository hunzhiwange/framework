{
    "name": "leevel/auth",
    "description": "The Leevel Auth Package.",
    "license": "MIT",
    "homepage": "http://queryphp.com",
    "support": {
        "issues": "https://github.com/hunzhiwange/framework/issues",
        "source": "https://github.com/hunzhiwange/framework"
    },
    "authors": [{
        "name": "Xiangmin Liu",
        "email": "635750556@qq.com"
    }],
    "require": {
        "php": ">=8.5.6",
        "leevel/support": "^2.0",
        "leevel/cache": "^2.0",
        "leevel/http": "^2.0",
        "firebase/php-jwt": "^6.10.1"
    },
    "suggest": {
        "leevel/session": "Required to use the session based guard (^2.0)."
    },
    "autoload": {
        "psr-4": {
            "Leevel\\Auth\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.0-dev"
        },
        "leevel": {
            "providers": [
                "Leevel\\Auth\\Provider\\Register"
            ]
        }
    },
    "minimum-stability": "dev"
}

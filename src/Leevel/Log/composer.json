{
    "name": "leevel/log",
    "description": "The Leevel Log Package.",
    "license": "MIT",
    "homepage": "http://queryphp.com",
    "support": {
        "issues": "https://github.com/hunzhiwange/framework/issues",
        "source": "https://github.com/hunzhiwange/framework"
    },
    "authors": [{
        "name": "Xiangmin Liu",
        "email": "635750556@qq.com"
    }],
    "require": {
        "php": ">=8.5.6",
        "leevel/support": "^2.0",
        "leevel/event": "^2.0",
        "monolog/monolog": "^3.10.0"
    },
    "require-dev": {
        "swoole/ide-helper": "^6.0.2"
    },
    "suggest": {
        "leevel/http": "Required to use log middleware (^2.0).",
        "leevel/filesystem": "Required to use the make commands (^2.0).",
        "leevel/console": "Required to use the make commands (^2.0).",
        "ext-swoole": "Required to use swoole (^6.0.2)."
    },
    "autoload": {
        "psr-4": {
            "Leevel\\Log\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.0-dev"
        },
        "leevel": {
            "providers": [
                "Leevel\\Log\\Provider\\Register"
            ],
            "commands": "Leevel\\Log\\Console"
        }
    },
    "minimum-stability": "dev"
}

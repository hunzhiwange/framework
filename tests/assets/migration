#!/usr/bin/env php
<?php

declare(strict_types=1);

use Leevel\Config\Config;
use Leevel\Database\Migrations\Application;
use Leevel\Database\Provider\Register;
use Leevel\Di\Container;
use Leevel\Event\Dispatch;
use Leevel\Event\Provider\Register as EventRegister;

// 读取配置并且返回配置值
require_once __DIR__.'/../config.php';

$autoloader = function (): bool {
    $files = [
        __DIR__.'/../../../../autoload.php', // composer dependency
        __DIR__.'/../../vendor/autoload.php', // stand-alone package
    ];
    foreach ($files as $file) {
        if (is_file($file)) {
            require_once $file;

            return true;
        }
    }

    return false;
};

if (!$autoloader()) {
    exit(
        'You need to set up the project dependencies using the following commands:'.PHP_EOL.
        'curl -sS https://getcomposer.org/installer | php'.PHP_EOL.
        'php composer.phar install'.PHP_EOL
    );
}

$createContainer = static function (): Container {
    $container = Container::singletons();

    $config = new Config([
        'database' => [
            'default' => 'mysql',
            'connect' => [
                'mysql' => [
                    'driver' => 'mysql',
                    'host' => $GLOBALS['LEEVEL_ENV']['DATABASE']['MYSQL']['HOST'],
                    'port' => $GLOBALS['LEEVEL_ENV']['DATABASE']['MYSQL']['PORT'],
                    'name' => $GLOBALS['LEEVEL_ENV']['DATABASE']['MYSQL']['NAME'],
                    'user' => $GLOBALS['LEEVEL_ENV']['DATABASE']['MYSQL']['USER'],
                    'password' => $GLOBALS['LEEVEL_ENV']['DATABASE']['MYSQL']['PASSWORD'],
                    'charset' => 'utf8mb4',
                    'configs' => [
                        PDO::ATTR_PERSISTENT => false,
                        PDO::ATTR_CASE => PDO::CASE_NATURAL,
                        PDO::ATTR_ORACLE_NULLS => PDO::NULL_NATURAL,
                        PDO::ATTR_STRINGIFY_FETCHES => false,
                        PDO::ATTR_EMULATE_PREPARES => false,
                        PDO::ATTR_TIMEOUT => 30,
                    ],
                    'separate' => false,
                    'master' => [],
                    'slave' => [],
                ],
                'testing' => [
                    'driver' => 'mysql',
                    'host' => '127.0.0.1',
                    'port' => 3306,
                    'name' => 'test',
                    'user' => 'root',
                    'password' => '',
                ],
            ],
        ],
    ]);

    $container->singleton('config', $config);

    return $container;
};

$container = $createContainer();

// 注册事件监听器
$eventRegister = new EventRegister($container);
$eventRegister->register();
$container->alias($eventRegister->providers());

// 注册数据库
$databaseRegister = new Register($container);
$databaseRegister->register();
$container->alias($databaseRegister->providers());
$databaseRegister->bootstrap(new Dispatch($container));

$app = new Application();
$app->run();
